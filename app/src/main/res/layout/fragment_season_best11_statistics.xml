<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SeasonBest11Statistics">

    <Toolbar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/teal_toolbar"
        android:id="@+id/toolbar">

        <RelativeLayout
            android:id="@+id/toolbar_select"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="10sp"
            android:paddingTop="10sp"
            android:paddingBottom="10sp">

            <ImageView
                android:id="@+id/season"
                android:layout_width="25sp"
                android:layout_height="25sp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/season"
                android:contentDescription="@string/season" />

            <TextView
                android:id="@+id/season_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:textSize="11sp"
                android:textColor="@color/black"
                android:layout_marginTop="6sp"
                android:src="@drawable/season"
                android:layout_marginEnd="28sp"
                tools:ignore="RelativeOverlap" />

            <ImageView
                android:id="@+id/logout"
                android:layout_width="25sp"
                android:layout_height="25sp"
                android:layout_alignParentEnd="true"
                android:src="@drawable/logout"
                android:visibility="gone"
                android:tooltipText="@string/logout"
                android:contentDescription="@string/logout" />

            <ImageView
                android:id="@+id/back_to_championship_prediction"
                android:layout_width="25sp"
                android:layout_height="25sp"
                android:gravity="center"
                android:src="@drawable/back"
                android:tooltipText="@string/back_to_championship_prediction"
                android:contentDescription="@string/back_to_championship_prediction" />

            <TextView
                android:id="@+id/championship_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/season_best11_statistics"
                android:textColor="@color/black"
                android:gravity="center"
                android:textSize="20sp"
                android:fontFamily="sans-serif-condensed-medium"
                android:layout_below="@+id/season"/>
        </RelativeLayout>
    </Toolbar>

    <ProgressBar
        android:id="@+id/progress_updating_best11_statistics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10sp"
        android:indeterminate="true"
        android:layout_below="@id/toolbar"/>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="10sp"
        android:layout_marginHorizontal="10sp"
        android:layout_below="@id/toolbar">

        <TextView
            android:id="@+id/total_points_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-condensed-medium"
            android:gravity="center"
            android:textSize="16sp"
            android:text="@string/best11_chosen_players_podium"
            android:textColor="@color/module"/>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="10sp"
            android:layout_below="@id/total_points_description">

            <ImageView
                android:id="@+id/player_argent"
                android:layout_width="100sp"
                android:layout_height="110sp"
                android:layout_marginTop="40sp"
                android:contentDescription="@string/best11_chosen_players_podium"
                android:src="@color/argent" />

            <ImageView
                android:id="@+id/player_team_argent"
                android:layout_width="45sp"
                android:layout_height="45sp"
                android:paddingTop="5sp"
                android:paddingBottom="5dp"
                android:layout_marginTop="45sp"
                android:layout_marginStart="27.5sp"
                android:contentDescription="@string/team" />

            <ImageView
                android:id="@+id/player_oro"
                android:layout_width="100sp"
                android:layout_height="150sp"
                android:layout_toEndOf="@id/player_argent"
                android:layout_marginStart="10sp"
                android:contentDescription="@string/best11_chosen_players_podium"
                android:src="@color/oro" />

            <ImageView
                android:id="@+id/player_team_oro"
                android:layout_width="50sp"
                android:layout_height="50sp"
                android:layout_toEndOf="@id/player_argent"
                android:paddingTop="5sp"
                android:paddingBottom="5dp"
                android:layout_marginTop="5sp"
                android:layout_marginStart="34.5sp"
                android:contentDescription="@string/team" />

            <ImageView
                android:id="@+id/player_bronze"
                android:layout_width="100sp"
                android:layout_height="70sp"
                android:layout_toEndOf="@id/player_oro"
                android:layout_marginStart="10sp"
                android:layout_marginTop="80sp"
                android:contentDescription="@string/best11_chosen_players_podium"
                android:src="@color/bronze" />

            <ImageView
                android:id="@+id/player_team_bronze"
                android:layout_width="40sp"
                android:layout_height="40sp"
                android:layout_toEndOf="@id/player_oro"
                android:paddingTop="5sp"
                android:paddingBottom="5dp"
                android:layout_marginTop="85sp"
                android:layout_marginStart="39.5sp"
                android:contentDescription="@string/team" />

        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>